# Supabase — required for sync endpoints
# Either of these name-pairs works (both are checked at runtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alternative naming (e.g. if you share this env with a Next.js project)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_ANON_KEY=your-anon-key

# Content extraction — set to "true" to use a headless browser fallback
# for sites that block simple HTTP scraping. Default: false
AGGREGATOR_BROWSER_HEADLESS=false

# Optional aggregator tuning (all have sensible defaults)
# AGGREGATOR_DEBUG=false
# AGGREGATOR_CACHE_TTL_SECONDS=300
# AGGREGATOR_REQUESTS_PER_SECOND=2.0
# AGGREGATOR_REQUEST_TIMEOUT_SECONDS=10
# AGGREGATOR_MAX_ARTICLES_PER_FEED=50
# AGGREGATOR_MAX_TOTAL_ARTICLES=200
